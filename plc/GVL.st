VAR_GLOBAL
(* =========================================================================
   LMM 拉毛机 全局变量（唯一 GVL）
   轴：X=M1+M2，Y=M3，Z=M4，R=M5。跨距 = Y 行程（HMI_rWheelBase，4~6 m）。
   维护方式：编辑本文件后运行 tools/inject_st.py 注入 LMM.xml。
   ========================================================================= *)

(* ===== 1. 面板物理 IO（地址固定勿改） ===== *)
StartBtn AT %IX1.6 : BOOL;      (* 【面板启动】→ HMI_xStart *)
StopBtn AT %IX1.4 : BOOL;       (* 【面板停止】→ HMI_xStop *)
