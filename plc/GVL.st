xEStopLatched : BOOL;           (* 【急停锁存】仅复位可清 *)
xFaultAggregate : BOOL;         (* 【故障汇总】任轴 ErrorStop *)
eCtrlSrc : INT;                 (* 【控制源】0=面板/触摸屏 1=远程Web；仅 PRG_TcpHmi 写 *)

(* ===== 3. 设备状态显示（Logic 写，只读派生，不做互锁） ===== *)
