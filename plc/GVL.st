EStop AT %IX0.4 : BOOL;         (* 【面板急停】正常=TRUE 按下=FALSE *)
StopLamp AT %QX0.6 : BOOL;      (* 【停止指示灯】← Dev_xStop *)
StartLamp AT %QX0.7 : BOOL;     (* 【运行指示灯】← Dev_xRun *)
JogFwd : BOOL;                  (* 【面板前进】手动 X+ *)
JogBwd : BOOL;                  (* 【面板后退】手动 X- *)
JogRight : BOOL;                (* 【面板右】手动 Y+ *)
JogLeft : BOOL;                 (* 【面板左】手动 Y- *)
JogUp : BOOL;                   (* 【面板上】手动 Z+ *)
JogDown : BOOL;                 (* 【面板下】手动 Z- *)
JogClockAdd : BOOL;             (* 【面板顺时针】手动 R+ *)
JogClockMis : BOOL;             (* 【面板逆时针】手动 R- *)

(* ===== 2. 安全 / 起停（PRG_TcpHmi 仲裁后写） ===== *)
HMI_xEStop : BOOL;              (* 【急停】TRUE正常 FALSE按下 = 物理 AND 触摸屏Req AND Web *)
