{
  "name": "lmm-webhmi-gateway",
  "private": true,
  "version": "1.0.0",
  "description": "Modbus TCP Server and WebSocket gateway for LMM WebHMI",
  "main": "server.js",
  "scripts": {
    "start": "node -e \"process.env.MOCK_PLC='1'; require('./server.js')\"",
    "start:plc": "node -e \"process.env.MOCK_PLC='0'; require('./server.js')\"",
    "test": "cd .. && node --test gateway/test/*.test.js"
  },
  "dependencies": {
    "modbus-serial": "^8.0.25",
    "ws": "^8.18.0"
  }
}
