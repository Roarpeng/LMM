  <types>
    <dataTypes />
    <pous>
      <pou name="PRG_Axis_Control" pouType="program">
        <interface>
          <localVars>
            <variable name="fbM1">
              <type>
                <derived name="FB_Servo" />
              </type>
            </variable>
            <variable name="fbM2">
              <type>
                <derived name="FB_Servo" />
              </type>
            </variable>
            <variable name="fbY">
              <type>
                <derived name="FB_Servo" />
              </type>
            </variable>
            <variable name="fbZ">
              <type>
                <derived name="FB_Servo" />
              </type>
            </variable>
            <variable name="fbXDiff">
              <type>
                <derived name="FB_XDiff" />
              </type>
            </variable>
            <variable name="xPair">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="eModeX">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="xDiffPos">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xDiffNeg">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="rXVel">
              <type>
                <REAL />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(*==============================================================================
 * PRG_Axis_Control — 运动独立任务（AxisTask）
 * 仅通过 GVL_AxisCmd 输入 / GVL_AxisFb 输出；禁止被外部 CALL
 * 轴绑定：Axis=M1, Axis_1=M2, Axis_2=Y, Axis_3=Z
 *============================================================================*)

(* X：同步直行 / 左右旋；VelX 与 SpinVel 分开 *)
eModeX := 0;
xDiffPos := FALSE; xDiffNeg := FALSE;
IF AxisCmd_xSpinLeft XOR AxisCmd_xSpinRight THEN
	eModeX := 2;
	xDiffPos := AxisCmd_xSpinLeft;
	xDiffNeg := AxisCmd_xSpinRight;
	rXVel := AxisCmd_rSpinVel;
ELSIF AxisCmd_xJogXPos XOR AxisCmd_xJogXNeg THEN
	eModeX := 1;
	rXVel := AxisCmd_rJogVelX;
ELSE
	rXVel := 0.0;
END_IF;

fbXDiff(
	eMode := eModeX,
	eDiffFunc := 1,
	xJogSyncPos := AxisCmd_xJogXPos,
	xJogSyncNeg := AxisCmd_xJogXNeg,
	xJogDiffPos := xDiffPos,
	xJogDiffNeg := xDiffNeg,
	xStop := AxisCmd_xStopAll,
	xEnable := AxisCmd_xPower,
	rJogVel := rXVel,
	rDiffDelta := 0.0,
	rTurnOmega := 0.0,
	rWheelBase := AxisCmd_rWheelBase
);
xPair := fbXDiff.xUsePairVel;

IF xPair THEN
	(* 成对模式：用 FB_XDiff 输出的有符号速度 *)
	fbM1(
		Axis := _MC_Axis[1],
		xEnable := AxisCmd_xPower,
		xJogPos := FALSE, xJogNeg := FALSE,
		xStop := AxisCmd_xStopAll,
		xResetFault := AxisCmd_xResetFault,
		xHome := FALSE,
		xUseVelCmd := TRUE,
		rVelCmd := fbXDiff.rVelCmdM1,
		rJogVel := rXVel,
		rAcc := AxisCmd_rAcc,
		rDec := AxisCmd_rDec
	);
	fbM2(
		Axis := _MC_Axis[2],
		xEnable := AxisCmd_xPower,
		xJogPos := FALSE, xJogNeg := FALSE,
		xStop := AxisCmd_xStopAll,
		xResetFault := AxisCmd_xResetFault,
		xHome := FALSE,
		xUseVelCmd := TRUE,
		rVelCmd := fbXDiff.rVelCmdM2,
		rJogVel := rXVel,
		rAcc := AxisCmd_rAcc,
		rDec := AxisCmd_rDec
	);
	AxisFb_rVelCmdM1 := fbXDiff.rVelCmdM1;
	AxisFb_rVelCmdM2 := fbXDiff.rVelCmdM2;
ELSE
	(* 无 X 命令：两侧保持上电待机 *)
	fbM1(
		Axis := _MC_Axis[1],
		xEnable := AxisCmd_xPower,
		xJogPos := FALSE, xJogNeg := FALSE,
		xStop := AxisCmd_xStopAll,
		xResetFault := AxisCmd_xResetFault,
		xHome := FALSE,
		xUseVelCmd := FALSE,
		rVelCmd := 0.0,
		rJogVel := AxisCmd_rJogVelX,
		rAcc := AxisCmd_rAcc,
		rDec := AxisCmd_rDec
	);
	fbM2(
		Axis := _MC_Axis[2],
		xEnable := AxisCmd_xPower,
		xJogPos := FALSE, xJogNeg := FALSE,
		xStop := AxisCmd_xStopAll,
		xResetFault := AxisCmd_xResetFault,
		xHome := FALSE,
		xUseVelCmd := FALSE,
		rVelCmd := 0.0,
		rJogVel := AxisCmd_rJogVelX,
		rAcc := AxisCmd_rAcc,
		rDec := AxisCmd_rDec
	);
	AxisFb_rVelCmdM1 := 0.0;
	AxisFb_rVelCmdM2 := 0.0;
END_IF;

(* Y / Z *)
fbY(
	Axis := _MC_Axis[3],
	xEnable := AxisCmd_xPower,
	xJogPos := AxisCmd_xJogYPos,
	xJogNeg := AxisCmd_xJogYNeg,
	xStop := AxisCmd_xStopAll,
	xResetFault := AxisCmd_xResetFault,
	xHome := FALSE,
	xUseVelCmd := FALSE,
	rVelCmd := 0.0,
	rJogVel := AxisCmd_rJogVelY,
	rAcc := AxisCmd_rAcc,
	rDec := AxisCmd_rDec
);
fbZ(
	Axis := _MC_Axis[4],
	xEnable := AxisCmd_xPower,
	xJogPos := AxisCmd_xJogZPos,
	xJogNeg := AxisCmd_xJogZNeg,
	xStop := AxisCmd_xStopAll,
	xResetFault := AxisCmd_xResetFault,
	xHome := FALSE,
	xUseVelCmd := FALSE,
	rVelCmd := 0.0,
	rJogVel := AxisCmd_rJogVelZ,
	rAcc := AxisCmd_rAcc,
	rDec := AxisCmd_rDec
);

(* ---------- 写反馈区（仅本任务可写） ---------- *)
AxisFb_rPosM1 := fbM1.rActPos;
AxisFb_rPosM2 := fbM2.rActPos;
AxisFb_rPosY := fbY.rActPos;
AxisFb_rPosZ := fbZ.rActPos;
AxisFb_xMovingM1 := fbM1.xMoving;
AxisFb_xMovingM2 := fbM2.xMoving;
AxisFb_xMovingY := fbY.xMoving;
AxisFb_xMovingZ := fbZ.xMoving;
AxisFb_xPoweredM1 := fbM1.xPowered;
AxisFb_xPoweredM2 := fbM2.xPowered;
AxisFb_xPoweredY := fbY.xPowered;
AxisFb_xPoweredZ := fbZ.xPowered;
AxisFb_xFaultM1 := fbM1.xFault;
AxisFb_xFaultM2 := fbM2.xFault;
AxisFb_xFaultY := fbY.xFault;
AxisFb_xFaultZ := fbZ.xFault;
AxisFb_xHomedY := fbY.xHomed;
AxisFb_xHomedZ := fbZ.xHomed;
AxisFb_xStandstill1 := fbM1.xStandstill;
AxisFb_xStandstill2 := fbM2.xStandstill;
AxisFb_xStandstillY := fbY.xStandstill;
AxisFb_xStandstillZ := fbZ.xStandstill;
AxisFb_xReady := NOT (fbM1.xFault OR fbM2.xFault OR fbY.xFault OR fbZ.xFault);
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/pathstructure" handleUnknown="discard">
            <pathStructure isFolder="False" name="Device" namespace="1ee21fdd-5562-44a0-a3ce-665d74916d50" factoryName="Inovance.InoPro.InoDeviceObject.DeviceObjectFactory" factoryGuid="{84d12aa5-3225-473b-9df6-18af40889bdf}" objectGuid="d7de5ac3-3f30-45ac-8468-ec250b4e523b">
              <pathStructure isFolder="False" name="Plc Logic" namespace="00000000-0000-0000-0000-000000000000" factoryName="_3S.CoDeSys.PlcLogicObject.PlcLogicObjectFactory" factoryGuid="{8ceeba4e-ac7a-4fbd-9415-bfb2d98668ab}" objectGuid="8a291c6e-c5c5-4a07-8c04-1100df0e1491">
                <pathStructure isFolder="False" name="Application" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="_3S.CoDeSys.ApplicationObject.ApplicationObjectFactory" factoryGuid="{ECADC42E-716E-4ff3-A93C-0CD143F9743F}" objectGuid="69822df8-b9c0-4a01-9450-b2cdc030688c">
                  <pathStructure isFolder="False" name="PRG_Axis_Control" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="Inovance.InoPro.InoPOUObject.POUObjectFactory" factoryGuid="{39C4ED2B-903C-464c-9041-7DF4ECEE9609}" objectGuid="a1b2c3d4-e5f6-4789-a012-444444444444" />
                </pathStructure>
              </pathStructure>
            </pathStructure>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>a1b2c3d4-e5f6-4789-a012-444444444444</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="FB_TCPServer" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="i_xEnable">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="i_uiPort">
              <type>
                <UINT />
              </type>
            </variable>
            <variable name="i_xSendTrig">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="i_strSend">
              <type>
                <string length="512" />
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="o_xConnected">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="o_xRecvNew">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="o_strRecv">
              <type>
                <string length="512" />
              </type>
            </variable>
            <variable name="o_uiRecvLen">
              <type>
                <UINT />
              </type>
            </variable>
            <variable name="o_xSendDone">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="o_xError">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="o_wErrorID">
              <type>
                <WORD />
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="SktTCPServer">
              <type>
                <derived name="SktTCPServer" />
              </type>
            </variable>
            <variable name="SktTCPSend">
              <type>
                <derived name="SktTCPSend_C" />
              </type>
            </variable>
            <variable name="SktTCPRecv">
              <type>
                <derived name="SktTCPRecv_C" />
              </type>
            </variable>
            <variable name="stLocalAddress">
              <type>
                <derived name="ADDRESS" />
              </type>
            </variable>
            <variable name="stConnectParam">
              <type>
                <derived name="CONNCET_PARAM" />
              </type>
            </variable>
            <variable name="stConnectInfo">
              <type>
                <derived name="CONNECT_INFO" />
              </type>
            </variable>
            <variable name="abyRecv">
              <type>
                <array>
                  <dimension lower="0" upper="511" />
                  <baseType>
                    <BYTE />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="abySend">
              <type>
                <array>
                  <dimension lower="0" upper="511" />
                  <baseType>
                    <BYTE />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="pRecv">
              <type>
                <pointer>
                  <baseType>
                    <BYTE />
                  </baseType>
                </pointer>
              </type>
            </variable>
            <variable name="pSend">
              <type>
                <pointer>
                  <baseType>
                    <BYTE />
                  </baseType>
                </pointer>
              </type>
            </variable>
            <variable name="xSendPrev">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xRecvReady">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="i">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="n">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="uiLen">
              <type>
                <UINT />
              </type>
            </variable>
            <variable name="sOne">
              <type>
                <string length="1" />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(*==============================================================================
 * FB_TCPServer — 汇川 cmphctcpip / SktTCP*
 *
 * 编译错误根因与对策：
 *  C0032 STRING→ADDRESS     : strLocalAddress 用 ADDRESS 结构，勿传 STRING
 *  C0032 CONNECT_INFO→CONNCET_PARAM : Recv/Send 的 stConnect 用 CONNCET_PARAM
 *  C0078 ARRAY OF BYTE      : abyData 传 POINTER（ADR），勿直接传数组
 *
 * 若 ADDRESS 成员名不同：在 InoProShop 对 ADDRESS 按 F2，改下面两行赋值。
 * 常见：strIpAddress/uiPort 或 sIP/wPort 或 strIP/iPort
 *============================================================================*)
o_xRecvNew := FALSE;
o_xSendDone := FALSE;
IF NOT i_xEnable THEN
	o_xConnected := FALSE;
	RETURN;
END_IF;

stLocalAddress.strIPAddr := '0.0.0.0';
stLocalAddress.uiPort := i_uiPort;

SktTCPServer(
	xExecute := i_xEnable,
	diConnectID := DINT#1,
	strLocalAddress := stLocalAddress,
	xDone =&gt; ,
	xBusy =&gt; ,
	xError =&gt; o_xError,
	wErrorID =&gt; o_wErrorID,
	stConnectInfo =&gt; stConnectInfo);

(* Recv/Send 要 CONNCET_PARAM；与 Server 共用 ConnectID=1 *)
stConnectParam.diConnectID := DINT#1;

o_xConnected := SktTCPServer.xBusy OR SktTCPServer.xDone;

pRecv := ADR(abyRecv);
pSend := ADR(abySend);

SktTCPRecv(
	xEnable := i_xEnable AND o_xConnected,
	xEnCont := TRUE,
	stConnect := stConnectParam,
	abyData := pRecv,
	uiDataSize := UINT#512,
	xDone =&gt; ,
	xBusy =&gt; ,
	xError =&gt; ,
	wErrorID =&gt; ,
	xReady =&gt; xRecvReady,
	uiCount =&gt; o_uiRecvLen,
	eStatus =&gt; ,
	stConnectInfo =&gt; stConnectInfo);

IF xRecvReady AND (o_uiRecvLen &gt; 0) THEN
	o_xRecvNew := TRUE;
	IF o_uiRecvLen &gt; 512 THEN
		n := 512;
	ELSE
		n := UINT_TO_INT(o_uiRecvLen);
	END_IF;
	o_strRecv := '';
	FOR i := 0 TO (n - 1) DO
		IF (abyRecv[i] = 16#0A) OR (abyRecv[i] = 16#0D) THEN
			EXIT;
		END_IF;
		sOne := CHR(BYTE_TO_DWORD(abyRecv[i]));
		o_strRecv := CONCAT(o_strRecv, sOne);
	END_FOR;
END_IF;

IF i_xSendTrig AND NOT xSendPrev AND (LEN(i_strSend) &gt; 0) THEN
	n := LEN(i_strSend);
	IF n &gt; 512 THEN n := 512; END_IF;
	FOR i := 1 TO n DO
		(* Codesys 字符串下标为 BYTE 码；若编译不过改用 CODE()/ASC() *)
		abySend[i - 1] := i_strSend[i];
	END_FOR;
	uiLen := INT_TO_UINT(n);
	SktTCPSend(
		xExecute := TRUE,
		xEnCont := FALSE,
		stConnect := stConnectParam,
		abyData := pSend,
		uiDataSize := uiLen,
		uiTimeOut := UINT#100,
		xDone =&gt; o_xSendDone,
		xBusy =&gt; ,
		xError =&gt; ,
		wErrorID =&gt; ,
		eStatus =&gt; ,
		stConnectInfo =&gt; );
ELSE
	SktTCPSend(
		xExecute := FALSE,
		xEnCont := FALSE,
		stConnect := stConnectParam,
		abyData := pSend,
		uiDataSize := UINT#0,
		uiTimeOut := UINT#100,
		xDone =&gt; ,
		xBusy =&gt; ,
		xError =&gt; ,
		wErrorID =&gt; ,
		eStatus =&gt; ,
		stConnectInfo =&gt; );
END_IF;
xSendPrev := i_xSendTrig;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/pathstructure" handleUnknown="discard">
            <pathStructure isFolder="False" name="Device" namespace="1ee21fdd-5562-44a0-a3ce-665d74916d50" factoryName="Inovance.InoPro.InoDeviceObject.DeviceObjectFactory" factoryGuid="{84d12aa5-3225-473b-9df6-18af40889bdf}" objectGuid="d7de5ac3-3f30-45ac-8468-ec250b4e523b">
              <pathStructure isFolder="False" name="Plc Logic" namespace="00000000-0000-0000-0000-000000000000" factoryName="_3S.CoDeSys.PlcLogicObject.PlcLogicObjectFactory" factoryGuid="{8ceeba4e-ac7a-4fbd-9415-bfb2d98668ab}" objectGuid="8a291c6e-c5c5-4a07-8c04-1100df0e1491">
                <pathStructure isFolder="False" name="Application" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="_3S.CoDeSys.ApplicationObject.ApplicationObjectFactory" factoryGuid="{ECADC42E-716E-4ff3-A93C-0CD143F9743F}" objectGuid="69822df8-b9c0-4a01-9450-b2cdc030688c">
                  <pathStructure isFolder="True" name="FB" namespace="00000000-0000-0000-0000-000000000000" factoryName="Inovance.InoPro.InoNavigators.FolderObjectFactory" factoryGuid="{BA66A801-C738-4176-B072-DFE26ACE36D3}" objectGuid="2dc75837-520f-43d9-90dd-47cded0212a2">
                    <pathStructure isFolder="False" name="FB_TCPServer" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="Inovance.InoPro.InoPOUObject.POUObjectFactory" factoryGuid="{39C4ED2B-903C-464c-9041-7DF4ECEE9609}" objectGuid="7e0c956a-cfc2-4be8-b176-5148d3ef493a" />
                  </pathStructure>
                </pathStructure>
              </pathStructure>
            </pathStructure>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>7e0c956a-cfc2-4be8-b176-5148d3ef493a</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="PRG_TcpHmi" pouType="program">
        <interface>
          <localVars>
            <variable name="fbTcp">
              <type>
                <derived name="FB_TCPServer" />
              </type>
            </variable>
            <variable name="tonWatch">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="tonSend">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="abySend">
              <type>
                <array>
                  <dimension lower="0" upper="1023" />
                  <baseType>
                    <BYTE />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="abyRecv">
              <type>
                <array>
                  <dimension lower="0" upper="1023" />
                  <baseType>
                    <BYTE />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="strLine">
              <type>
                <string length="512" />
              </type>
            </variable>
            <variable name="strOut">
              <type>
                <string length="512" />
              </type>
            </variable>
            <variable name="i">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="n">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="xSendTrig">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="uiSendLen">
              <type>
                <UINT />
              </type>
            </variable>
            <variable name="p">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="xInit">
              <type>
                <BOOL />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(*==============================================================================
 * PRG_TcpHmi — TCP JSON HMI 桥（Server :Tcp_uiPort）
 * 写影子 Tcp_*；读 HMI_Status / AxisFb 组 t:s
 *============================================================================*)
IF NOT xInit THEN
	Tcp_xEStop := TRUE;
	Tcp_rJogVelX := 0.4; Tcp_rSpinVel := 0.3;
	Tcp_rJogVelY := 0.3; Tcp_rJogVelZ := 0.2; Tcp_rJogVelR := 0.2;
	Tcp_rAutoDistX := 1.0; Tcp_rAutoVelX := 0.4;
	Tcp_rAutoVelY := 0.3; Tcp_rAutoVelZ := 0.15;
	Tcp_rWheelBase := 5.0; Tcp_rForceSet := 100.0;
	Tcp_xForceSimEnable := TRUE;
	IF Tcp_uiPort = 0 THEN Tcp_uiPort := 9100; END_IF;
	xInit := TRUE;
END_IF;

fbTcp(
	i_xEnable := TRUE,
	i_uiPort := Tcp_uiPort,
	i_xSendTrig := xSendTrig,
	i_strSend := strOut,
	o_xConnected =&gt; Tcp_xConnected,
	o_xRecvNew =&gt; ,
	o_strRecv =&gt; strLine,
	o_uiRecvLen =&gt; ,
	o_xSendDone =&gt; ,
	o_xError =&gt; ,
	o_wErrorID =&gt; );

xSendTrig := FALSE;

IF fbTcp.o_xRecvNew THEN
	(* 心跳 *)
	IF FIND(strLine, '"t":"ping"') &gt; 0 OR FIND(strLine, '"t": "ping"') &gt; 0 THEN
		(* pong 随下次状态发 *)
	END_IF;
	(* BOOL *)
	IF FIND(strLine, '"HMI_xEStop":false') &gt; 0 OR FIND(strLine, '"HMI_xEStop": false') &gt; 0 THEN Tcp_xEStop := FALSE;
	ELSIF FIND(strLine, '"HMI_xEStop":true') &gt; 0 OR FIND(strLine, '"HMI_xEStop": true') &gt; 0 THEN Tcp_xEStop := TRUE; END_IF;
	IF FIND(strLine, '"HMI_xStop":true') &gt; 0 THEN Tcp_xStop := TRUE;
	ELSIF FIND(strLine, '"HMI_xStop":false') &gt; 0 THEN Tcp_xStop := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xStopHold3s":true') &gt; 0 THEN Tcp_xStopHold3s := TRUE;
	ELSIF FIND(strLine, '"HMI_xStopHold3s":false') &gt; 0 THEN Tcp_xStopHold3s := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xStart":true') &gt; 0 THEN Tcp_xStart := TRUE; Tcp_xEnable := TRUE;
	ELSIF FIND(strLine, '"HMI_xStart":false') &gt; 0 THEN Tcp_xStart := FALSE; Tcp_xEnable := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xEnable":true') &gt; 0 THEN Tcp_xEnable := TRUE;
	ELSIF FIND(strLine, '"HMI_xEnable":false') &gt; 0 THEN Tcp_xEnable := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xAutoMode":true') &gt; 0 THEN Tcp_xAutoMode := TRUE;
	ELSIF FIND(strLine, '"HMI_xAutoMode":false') &gt; 0 THEN Tcp_xAutoMode := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xJogXPos":true') &gt; 0 THEN Tcp_xJogXPos := TRUE;
	ELSIF FIND(strLine, '"HMI_xJogXPos":false') &gt; 0 THEN Tcp_xJogXPos := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xJogXNeg":true') &gt; 0 THEN Tcp_xJogXNeg := TRUE;
	ELSIF FIND(strLine, '"HMI_xJogXNeg":false') &gt; 0 THEN Tcp_xJogXNeg := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xSpinLeft":true') &gt; 0 THEN Tcp_xSpinLeft := TRUE;
	ELSIF FIND(strLine, '"HMI_xSpinLeft":false') &gt; 0 THEN Tcp_xSpinLeft := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xSpinRight":true') &gt; 0 THEN Tcp_xSpinRight := TRUE;
	ELSIF FIND(strLine, '"HMI_xSpinRight":false') &gt; 0 THEN Tcp_xSpinRight := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xJogYPos":true') &gt; 0 THEN Tcp_xJogYPos := TRUE;
	ELSIF FIND(strLine, '"HMI_xJogYPos":false') &gt; 0 THEN Tcp_xJogYPos := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xJogYNeg":true') &gt; 0 THEN Tcp_xJogYNeg := TRUE;
	ELSIF FIND(strLine, '"HMI_xJogYNeg":false') &gt; 0 THEN Tcp_xJogYNeg := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xJogZPos":true') &gt; 0 THEN Tcp_xJogZPos := TRUE;
	ELSIF FIND(strLine, '"HMI_xJogZPos":false') &gt; 0 THEN Tcp_xJogZPos := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xJogZNeg":true') &gt; 0 THEN Tcp_xJogZNeg := TRUE;
	ELSIF FIND(strLine, '"HMI_xJogZNeg":false') &gt; 0 THEN Tcp_xJogZNeg := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xJogRPos":true') &gt; 0 THEN Tcp_xJogRPos := TRUE;
	ELSIF FIND(strLine, '"HMI_xJogRPos":false') &gt; 0 THEN Tcp_xJogRPos := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xJogRNeg":true') &gt; 0 THEN Tcp_xJogRNeg := TRUE;
	ELSIF FIND(strLine, '"HMI_xJogRNeg":false') &gt; 0 THEN Tcp_xJogRNeg := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xAutoStart":true') &gt; 0 THEN Tcp_xAutoStart := TRUE;
	ELSIF FIND(strLine, '"HMI_xAutoStart":false') &gt; 0 THEN Tcp_xAutoStart := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xAutoAbort":true') &gt; 0 THEN Tcp_xAutoAbort := TRUE;
	ELSIF FIND(strLine, '"HMI_xAutoAbort":false') &gt; 0 THEN Tcp_xAutoAbort := FALSE; END_IF;
	IF FIND(strLine, '"HMI_xForceSimEnable":true') &gt; 0 THEN Tcp_xForceSimEnable := TRUE;
	ELSIF FIND(strLine, '"HMI_xForceSimEnable":false') &gt; 0 THEN Tcp_xForceSimEnable := FALSE; END_IF;
	(* REAL：网关保证无空格；键后直接数字 *)
	p := FIND(strLine, '"HMI_rJogVelX":');
	IF p &gt; 0 THEN Tcp_rJogVelX := STRING_TO_REAL(MID(strLine, p + 15, 16)); END_IF;
	p := FIND(strLine, '"HMI_rSpinVel":');
	IF p &gt; 0 THEN Tcp_rSpinVel := STRING_TO_REAL(MID(strLine, p + 14, 16)); END_IF;
	p := FIND(strLine, '"HMI_rJogVelY":');
	IF p &gt; 0 THEN Tcp_rJogVelY := STRING_TO_REAL(MID(strLine, p + 15, 16)); END_IF;
	p := FIND(strLine, '"HMI_rJogVelZ":');
	IF p &gt; 0 THEN Tcp_rJogVelZ := STRING_TO_REAL(MID(strLine, p + 15, 16)); END_IF;
	p := FIND(strLine, '"HMI_rJogVelR":');
	IF p &gt; 0 THEN Tcp_rJogVelR := STRING_TO_REAL(MID(strLine, p + 15, 16)); END_IF;
	p := FIND(strLine, '"HMI_rAutoDistX":');
	IF p &gt; 0 THEN Tcp_rAutoDistX := STRING_TO_REAL(MID(strLine, p + 16, 16)); END_IF;
	p := FIND(strLine, '"HMI_rAutoVelX":');
	IF p &gt; 0 THEN Tcp_rAutoVelX := STRING_TO_REAL(MID(strLine, p + 15, 16)); END_IF;
	p := FIND(strLine, '"HMI_rAutoVelY":');
	IF p &gt; 0 THEN Tcp_rAutoVelY := STRING_TO_REAL(MID(strLine, p + 15, 16)); END_IF;
	p := FIND(strLine, '"HMI_rAutoVelZ":');
	IF p &gt; 0 THEN Tcp_rAutoVelZ := STRING_TO_REAL(MID(strLine, p + 15, 16)); END_IF;
	p := FIND(strLine, '"HMI_rWheelBase":');
	IF p &gt; 0 THEN Tcp_rWheelBase := STRING_TO_REAL(MID(strLine, p + 16, 16)); END_IF;
	p := FIND(strLine, '"HMI_rForceSet":');
	IF p &gt; 0 THEN Tcp_rForceSet := STRING_TO_REAL(MID(strLine, p + 15, 16)); END_IF;
	p := FIND(strLine, '"HMI_rForceSim":');
	IF p &gt; 0 THEN Tcp_rForceSim := STRING_TO_REAL(MID(strLine, p + 15, 16)); END_IF;
END_IF;

(* 有接收则本周期 IN=FALSE 复位；否则连接中计时 *)
tonWatch(IN := Tcp_xConnected AND NOT fbTcp.o_xRecvNew, PT := T#500MS);
Tcp_xTimeout := Tcp_xConnected AND tonWatch.Q;
IF Tcp_xTimeout OR NOT Tcp_xConnected THEN
	Tcp_xStop := FALSE; Tcp_xStopHold3s := FALSE;
	Tcp_xStart := FALSE; Tcp_xEnable := FALSE;
	Tcp_xJogXPos := FALSE; Tcp_xJogXNeg := FALSE;
	Tcp_xSpinLeft := FALSE; Tcp_xSpinRight := FALSE;
	Tcp_xJogYPos := FALSE; Tcp_xJogYNeg := FALSE;
	Tcp_xJogZPos := FALSE; Tcp_xJogZNeg := FALSE;
	Tcp_xJogRPos := FALSE; Tcp_xJogRNeg := FALSE;
	Tcp_xAutoStart := FALSE; Tcp_xAutoAbort := FALSE;
	IF Tcp_xTimeout OR NOT Tcp_xConnected THEN Tcp_xEStop := TRUE; END_IF;
END_IF;

tonSend(IN := NOT tonSend.Q, PT := T#100MS);
IF tonSend.Q AND Tcp_xConnected THEN
	strOut := '{"t":"s"';
	strOut := CONCAT(strOut, ',"HMI_eDevState":');
	strOut := CONCAT(strOut, INT_TO_STRING(HMI_eDevState));
	strOut := CONCAT(strOut, ',"HMI_eOpMode":');
	strOut := CONCAT(strOut, INT_TO_STRING(HMI_eOpMode));
	strOut := CONCAT(strOut, ',"HMI_iAutoStepShow":');
	strOut := CONCAT(strOut, INT_TO_STRING(HMI_iAutoStepShow));
	strOut := CONCAT(strOut, ',"HMI_iAlarmShow":');
	strOut := CONCAT(strOut, INT_TO_STRING(HMI_iAlarmShow));
	strOut := CONCAT(strOut, ',"HMI_xDevStop":');
	strOut := CONCAT(strOut, SEL(HMI_xDevStop, 'false', 'true'));
	strOut := CONCAT(strOut, ',"HMI_xDevRun":');
	strOut := CONCAT(strOut, SEL(HMI_xDevRun, 'false', 'true'));
	strOut := CONCAT(strOut, ',"HMI_xDevError":');
	strOut := CONCAT(strOut, SEL(HMI_xDevError, 'false', 'true'));
	strOut := CONCAT(strOut, ',"HMI_xAutoBusy":');
	strOut := CONCAT(strOut, SEL(HMI_xAutoBusy, 'false', 'true'));
	strOut := CONCAT(strOut, ',"HMI_xAutoDone":');
	strOut := CONCAT(strOut, SEL(HMI_xAutoDone, 'false', 'true'));
	strOut := CONCAT(strOut, ',"HMI_xLampEStop":');
	strOut := CONCAT(strOut, SEL(HMI_xLampEStop, 'false', 'true'));
	strOut := CONCAT(strOut, ',"HMI_xLampEnableOk":');
	strOut := CONCAT(strOut, SEL(HMI_xLampEnableOk, 'false', 'true'));
	strOut := CONCAT(strOut, ',"HMI_xLampFault":');
	strOut := CONCAT(strOut, SEL(HMI_xLampFault, 'false', 'true'));
	strOut := CONCAT(strOut, ',"HMI_rForceShow":');
	strOut := CONCAT(strOut, REAL_TO_STRING(HMI_rForceShow));
	strOut := CONCAT(strOut, ',"Tcp_xConnected":true,"Tcp_xTimeout":');
	strOut := CONCAT(strOut, SEL(Tcp_xTimeout, 'false', 'true'));
	strOut := CONCAT(strOut, ',"AxisFb_rPosY":');
	strOut := CONCAT(strOut, REAL_TO_STRING(AxisFb_rPosY));
	strOut := CONCAT(strOut, ',"AxisFb_rPosZ":');
	strOut := CONCAT(strOut, REAL_TO_STRING(AxisFb_rPosZ));
	strOut := CONCAT(strOut, ',"AxisFb_xReady":');
	strOut := CONCAT(strOut, SEL(AxisFb_xReady, 'false', 'true'));
	strOut := CONCAT(strOut, '}');
	strOut := CONCAT(strOut, '$N');
	xSendTrig := TRUE;
END_IF;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/pathstructure" handleUnknown="discard">
            <pathStructure isFolder="False" name="Device" namespace="1ee21fdd-5562-44a0-a3ce-665d74916d50" factoryName="Inovance.InoPro.InoDeviceObject.DeviceObjectFactory" factoryGuid="{84d12aa5-3225-473b-9df6-18af40889bdf}" objectGuid="d7de5ac3-3f30-45ac-8468-ec250b4e523b">
              <pathStructure isFolder="False" name="Plc Logic" namespace="00000000-0000-0000-0000-000000000000" factoryName="_3S.CoDeSys.PlcLogicObject.PlcLogicObjectFactory" factoryGuid="{8ceeba4e-ac7a-4fbd-9415-bfb2d98668ab}" objectGuid="8a291c6e-c5c5-4a07-8c04-1100df0e1491">
                <pathStructure isFolder="False" name="Application" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="_3S.CoDeSys.ApplicationObject.ApplicationObjectFactory" factoryGuid="{ECADC42E-716E-4ff3-A93C-0CD143F9743F}" objectGuid="69822df8-b9c0-4a01-9450-b2cdc030688c">
                  <pathStructure isFolder="False" name="PRG_TcpHmi" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="Inovance.InoPro.InoPOUObject.POUObjectFactory" factoryGuid="{39C4ED2B-903C-464c-9041-7DF4ECEE9609}" objectGuid="a1b2c3d4-e5f6-4789-a012-555555555555" />
                </pathStructure>
              </pathStructure>
            </pathStructure>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>a1b2c3d4-e5f6-4789-a012-555555555555</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="FB_XDiff" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="eMode">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="eDiffFunc">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="xJogSyncPos">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xJogSyncNeg">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xJogDiffPos">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xJogDiffNeg">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xStop">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xEnable">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="rJogVel">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="rDiffDelta">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="rTurnOmega">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="rWheelBase">
              <type>
                <REAL />
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="rVelCmdM1">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="rVelCmdM2">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="xActive">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xUsePairVel">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xWheelBaseOk">
              <type>
                <BOOL />
              </type>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(*==============================================================================
 * FB_XDiff — 龙门 X 双驱速度合成（仅 Axis 任务内使用）
 * eMode: 0=独立  1=同步同速平移  2=差速（子功能见 eDiffFunc）
 * eDiffFunc: 0=纠偏  1=原地旋转(一正一反)  2=差速拐弯
 * 跨距 rWheelBase: 4..6 m；X 运动方向与 Y 垂直
 *============================================================================*)

(* 输出清零 *)
rVelCmdM1 := 0.0;
rVelCmdM2 := 0.0;
xUsePairVel := FALSE;
xActive := FALSE;
(* 跨距合法性 *)
xWheelBaseOk := (rWheelBase &gt;= 4.0) AND (rWheelBase &lt;= 6.0);

(* 未使能 / 停止 / 独立模式：不合成成对速度 *)
IF NOT xEnable OR xStop OR eMode = 0 THEN
	RETURN;
END_IF;

(* ---------- Sync：两侧同速，龙门沿 X 平移 ---------- *)
IF eMode = 1 THEN
	IF xJogSyncPos XOR xJogSyncNeg THEN
		xUsePairVel := TRUE;
		xActive := TRUE;
		IF xJogSyncPos THEN
			rVelCmdM1 := rJogVel;
		ELSE
			rVelCmdM1 := -rJogVel;
		END_IF;
		rVelCmdM2 := rVelCmdM1; (* 同速 *)
	END_IF;
	RETURN;
END_IF;

(* ---------- Diff：需有方向键 ---------- *)
IF NOT (xJogDiffPos XOR xJogDiffNeg) THEN
	RETURN;
END_IF;

(* 原地旋转 / 差速拐弯依赖合法跨距 *)
IF (eDiffFunc = 1 OR eDiffFunc = 2) AND NOT xWheelBaseOk THEN
	RETURN;
END_IF;

xUsePairVel := TRUE;
xActive := TRUE;

CASE eDiffFunc OF
	0: (* 纠偏：同向 V±Δ，扶正龙门 *)
		IF xJogDiffPos THEN
			rVelCmdM1 := rJogVel + rDiffDelta;
			rVelCmdM2 := rJogVel - rDiffDelta;
		ELSE
			rVelCmdM1 := -(rJogVel + rDiffDelta);
			rVelCmdM2 := -(rJogVel - rDiffDelta);
		END_IF;

	1: (* 原地旋转：M1/M2 一正一反，转角度 *)
		IF ABS(rTurnOmega) &gt; 1.0E-6 THEN
			rVelCmdM1 := rTurnOmega * rWheelBase * 0.5;
		ELSE
			rVelCmdM1 := rJogVel;
		END_IF;
		rVelCmdM2 := -rVelCmdM1;
		IF xJogDiffNeg THEN
			rVelCmdM1 := -rVelCmdM1;
			rVelCmdM2 := -rVelCmdM2;
		END_IF;

	2: (* 差速拐弯：两侧同向为主，速度差，可边走边弯 *)
		IF ABS(rTurnOmega) &gt; 1.0E-6 THEN
			rVelCmdM1 := rJogVel + rTurnOmega * rWheelBase * 0.5;
			rVelCmdM2 := rJogVel - rTurnOmega * rWheelBase * 0.5;
		ELSE
			rVelCmdM1 := rJogVel + rDiffDelta;
			rVelCmdM2 := rJogVel - rDiffDelta;
		END_IF;
		IF xJogDiffNeg THEN
			rVelCmdM1 := -rVelCmdM1;
			rVelCmdM2 := -rVelCmdM2;
		END_IF;

ELSE
	xUsePairVel := FALSE;
	xActive := FALSE;
END_CASE;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/pathstructure" handleUnknown="discard">
            <pathStructure isFolder="False" name="Device" namespace="1ee21fdd-5562-44a0-a3ce-665d74916d50" factoryName="Inovance.InoPro.InoDeviceObject.DeviceObjectFactory" factoryGuid="{84d12aa5-3225-473b-9df6-18af40889bdf}" objectGuid="d7de5ac3-3f30-45ac-8468-ec250b4e523b">
              <pathStructure isFolder="False" name="Plc Logic" namespace="00000000-0000-0000-0000-000000000000" factoryName="_3S.CoDeSys.PlcLogicObject.PlcLogicObjectFactory" factoryGuid="{8ceeba4e-ac7a-4fbd-9415-bfb2d98668ab}" objectGuid="8a291c6e-c5c5-4a07-8c04-1100df0e1491">
                <pathStructure isFolder="False" name="Application" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="_3S.CoDeSys.ApplicationObject.ApplicationObjectFactory" factoryGuid="{ECADC42E-716E-4ff3-A93C-0CD143F9743F}" objectGuid="69822df8-b9c0-4a01-9450-b2cdc030688c">
                  <pathStructure isFolder="True" name="FB" namespace="00000000-0000-0000-0000-000000000000" factoryName="Inovance.InoPro.InoNavigators.FolderObjectFactory" factoryGuid="{BA66A801-C738-4176-B072-DFE26ACE36D3}" objectGuid="2dc75837-520f-43d9-90dd-47cded0212a2">
                    <pathStructure isFolder="False" name="FB_XDiff" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="Inovance.InoPro.InoPOUObject.POUObjectFactory" factoryGuid="{39C4ED2B-903C-464c-9041-7DF4ECEE9609}" objectGuid="a1b2c3d4-e5f6-4789-a012-222222222222" />
                  </pathStructure>
                </pathStructure>
              </pathStructure>
            </pathStructure>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>a1b2c3d4-e5f6-4789-a012-222222222222</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="PLC_PRG" pouType="program">
        <interface />
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(*==============================================================================
 * PLC_PRG — 主任务入口（MainTask）
 * 只调用逻辑程序；禁止在此 CALL PRG_Axis_Control（轴控在独立 AxisTask）
 *============================================================================*)
PRG_TcpHmi();
PRG_Logic();
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/pathstructure" handleUnknown="discard">
            <pathStructure isFolder="False" name="Device" namespace="1ee21fdd-5562-44a0-a3ce-665d74916d50" factoryName="Inovance.InoPro.InoDeviceObject.DeviceObjectFactory" factoryGuid="{84d12aa5-3225-473b-9df6-18af40889bdf}" objectGuid="d7de5ac3-3f30-45ac-8468-ec250b4e523b">
              <pathStructure isFolder="False" name="Plc Logic" namespace="00000000-0000-0000-0000-000000000000" factoryName="_3S.CoDeSys.PlcLogicObject.PlcLogicObjectFactory" factoryGuid="{8ceeba4e-ac7a-4fbd-9415-bfb2d98668ab}" objectGuid="8a291c6e-c5c5-4a07-8c04-1100df0e1491">
                <pathStructure isFolder="False" name="Application" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="_3S.CoDeSys.ApplicationObject.ApplicationObjectFactory" factoryGuid="{ECADC42E-716E-4ff3-A93C-0CD143F9743F}" objectGuid="69822df8-b9c0-4a01-9450-b2cdc030688c">
                  <pathStructure isFolder="False" name="PLC_PRG" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="Inovance.InoPro.InoPOUObject.POUObjectFactory" factoryGuid="{39C4ED2B-903C-464c-9041-7DF4ECEE9609}" objectGuid="ff3e658d-23f1-4e79-9e6a-94708f19c17b" />
                </pathStructure>
              </pathStructure>
            </pathStructure>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>ff3e658d-23f1-4e79-9e6a-94708f19c17b</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="PRG_Logic" pouType="program">
        <interface>
          <localVars>
            <variable name="tonHold">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="tonResetHold">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="xResetPulse">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xResetPrev">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xStartEdge">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xStartPrev">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xStopEdge">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xStopPrev">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xPostResetHold">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xAutoStartPrev">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xAutoStartEdge">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="rRHold">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="xMoveXSent">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xMoveYSent">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xBridgeInited">
              <type>
                <BOOL />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(*==============================================================================
 * PRG_Logic — 设备态 / 手动裁定 / 自动步序 / 恒力
 * 禁止 CALL Axis / FB_Servo / FB_XDiff
 *============================================================================*)

(* —— 面板 ∨ TCP 影子 → HMI（见 docs/plc/TCP_HMI.md）—— *)
Tcp_xOnline := Tcp_xConnected AND NOT Tcp_xTimeout;
HMI_xEStop := EStop AND Tcp_xEStop;
HMI_xStop := StopBtn OR Tcp_xStop;
HMI_xStart := StartBtn OR Tcp_xStart;
HMI_xEnable := StartBtn OR Tcp_xEnable OR Tcp_xStart;
HMI_xStopHold3s := ResetBtn OR Tcp_xStopHold3s;
IF Tcp_xOnline THEN
	HMI_xAutoMode := Tcp_xAutoMode;
	HMI_xForceSimEnable := Tcp_xForceSimEnable;
END_IF;
HMI_xJogXPos := JogFwd OR Tcp_xJogXPos;
HMI_xJogXNeg := JogBwd OR Tcp_xJogXNeg;
HMI_xSpinLeft := Tcp_xSpinLeft;
HMI_xSpinRight := Tcp_xSpinRight;
HMI_xJogYPos := JogRight OR Tcp_xJogYPos;
HMI_xJogYNeg := JogLeft OR Tcp_xJogYNeg;
HMI_xJogZPos := JogUp OR Tcp_xJogZPos;
HMI_xJogZNeg := JogDown OR Tcp_xJogZNeg;
HMI_xJogRPos := Tcp_xJogRPos;
HMI_xJogRNeg := Tcp_xJogRNeg;
HMI_xAutoStart := Tcp_xAutoStart;
HMI_xAutoAbort := Tcp_xAutoAbort;
IF Tcp_xOnline THEN
	HMI_rJogVelX := Tcp_rJogVelX;
	HMI_rSpinVel := Tcp_rSpinVel;
	HMI_rJogVelY := Tcp_rJogVelY;
	HMI_rJogVelZ := Tcp_rJogVelZ;
	HMI_rJogVelR := Tcp_rJogVelR;
	HMI_rAutoDistX := Tcp_rAutoDistX;
	HMI_rAutoVelX := Tcp_rAutoVelX;
	HMI_rAutoVelY := Tcp_rAutoVelY;
	HMI_rAutoVelZ := Tcp_rAutoVelZ;
	HMI_rWheelBase := Tcp_rWheelBase;
	HMI_rForceSet := Tcp_rForceSet;
	HMI_rForceSim := Tcp_rForceSim;
ELSE
	HMI_rJogVelX := JogVel;
	HMI_rJogVelY := JogVel;
	HMI_rJogVelZ := JogVel;
END_IF;

(* —— 急停 / 复位 —— *)
IF NOT HMI_xEStop THEN xEStopLatched := TRUE; END_IF;
tonHold(IN := HMI_xStop AND HMI_xEStop, PT := T#3S);
xResetPulse := (HMI_xStopHold3s OR tonHold.Q) AND NOT xResetPrev;
xResetPrev := HMI_xStopHold3s OR tonHold.Q;
IF xResetPulse THEN
	xEStopLatched := FALSE;
	AxisCmd_xResetFault := TRUE;
	eDevState := 0;
	xPostResetHold := TRUE;
	iAutoStep := 0;
ELSE
	AxisCmd_xResetFault := FALSE;
END_IF;

xFaultAggregate := AxisFb_xFaultM1 OR AxisFb_xFaultM2 OR AxisFb_xFaultY OR AxisFb_xFaultZ
	OR (xM5Ready AND AxisFb_xFaultR)
	OR (NOT HMI_xForceSimEnable AND Force_xTimeout);
xEnablePermit := HMI_xEStop AND NOT xEStopLatched AND NOT xFaultAggregate;
IF HMI_xAutoMode THEN eOpMode := 1; ELSE eOpMode := 0; END_IF;
HMI_eOpMode := eOpMode;

tonResetHold(IN := xPostResetHold, PT := T#2S);
IF NOT xFaultAggregate AND HMI_xEStop AND NOT xEStopLatched THEN
	xPostResetHold := FALSE;
ELSIF tonResetHold.Q OR NOT HMI_xEStop OR xEStopLatched THEN
	xPostResetHold := FALSE;
END_IF;

xStartEdge := (HMI_xStart OR HMI_xEnable) AND NOT xStartPrev;
xStartPrev := HMI_xStart OR HMI_xEnable;
xStopEdge := HMI_xStop AND NOT xStopPrev;
xStopPrev := HMI_xStop;

IF xResetPulse THEN
	eDevState := 0;
ELSIF NOT HMI_xEStop OR xEStopLatched THEN
	eDevState := 2;
ELSIF xFaultAggregate AND NOT xPostResetHold THEN
	eDevState := 2;
ELSIF eDevState = 2 THEN
	;
ELSIF xStopEdge AND NOT tonHold.Q THEN
	eDevState := 0;
	iAutoStep := 0;
ELSIF xStartEdge AND eDevState = 0 AND xEnablePermit THEN
	eDevState := 1;
ELSIF xStartEdge AND eDevState = 0 AND NOT xEnablePermit THEN
	iAlarmID := 1004;
END_IF;

Dev_xStop := (eDevState = 0);
Dev_xRun := (eDevState = 1);
Dev_xError := (eDevState = 2);
HMI_eDevState := eDevState;
HMI_xDevStop := Dev_xStop;
HMI_xDevRun := Dev_xRun;
HMI_xDevError := Dev_xError;

(* 力：模拟或 PRG_Force485 *)
IF HMI_xForceSimEnable THEN
	rForceAct := HMI_rForceSim;
END_IF;
HMI_rForceShow := rForceAct;
IF rForceKp &lt; 1.0E-6 THEN rForceKp := 1.0; END_IF;

xIlk_BlockYPlus := I_xLimYPos; xIlk_BlockYNeg := I_xLimYNeg;
xIlk_BlockZPlus := I_xLimZPos; xIlk_BlockZNeg := I_xLimZNeg;
xIlk_BlockYWhenZ := FALSE;

AxisCmd_xStopAll := (eDevState &lt;&gt; 1) OR HMI_xStop OR HMI_xAutoAbort;
AxisCmd_xPower := (eDevState = 1);
AxisCmd_rJogVelX := HMI_rJogVelX;
AxisCmd_rSpinVel := HMI_rSpinVel;
AxisCmd_rJogVelY := HMI_rJogVelY;
AxisCmd_rJogVelZ := HMI_rJogVelZ;
AxisCmd_rJogVelR := HMI_rJogVelR;
AxisCmd_rWheelBase := LIMIT(4.0, HMI_rWheelBase, 6.0);
AxisCmd_rAcc := JogACC;
AxisCmd_rDec := JogDEC;
IF AxisCmd_rAcc &lt; 1.0 THEN AxisCmd_rAcc := 100.0; END_IF;
IF AxisCmd_rDec &lt; 1.0 THEN AxisCmd_rDec := 100.0; END_IF;

AxisCmd_xJogXPos := FALSE; AxisCmd_xJogXNeg := FALSE;
AxisCmd_xSpinLeft := FALSE; AxisCmd_xSpinRight := FALSE;
AxisCmd_xJogYPos := FALSE; AxisCmd_xJogYNeg := FALSE;
AxisCmd_xJogZPos := FALSE; AxisCmd_xJogZNeg := FALSE;
AxisCmd_xJogRPos := FALSE; AxisCmd_xJogRNeg := FALSE;
AxisCmd_xUseZVelCmd := FALSE; AxisCmd_rZVelCmd := 0.0;
AxisCmd_xMoveRelX := FALSE; AxisCmd_xMoveRelY := FALSE;
AxisCmd_xHoldR := FALSE;

xAutoStartEdge := HMI_xAutoStart AND NOT xAutoStartPrev;
xAutoStartPrev := HMI_xAutoStart;

IF Dev_xError OR HMI_xAutoAbort OR (eDevState &lt;&gt; 1) THEN
	iAutoStep := 0;
	HMI_xAutoBusy := FALSE;
END_IF;

(* ===== 手动：仅 RUN + 手动模式 ===== *)
IF Dev_xRun AND (eOpMode = 0) AND NOT HMI_xStop THEN
	IF HMI_xSpinLeft XOR HMI_xSpinRight THEN
		AxisCmd_xSpinLeft := HMI_xSpinLeft;
		AxisCmd_xSpinRight := HMI_xSpinRight;
	ELSIF HMI_xJogXPos XOR HMI_xJogXNeg THEN
		AxisCmd_xJogXPos := HMI_xJogXPos;
		AxisCmd_xJogXNeg := HMI_xJogXNeg;
	END_IF;
	AxisCmd_xJogYPos := HMI_xJogYPos AND NOT xIlk_BlockYPlus;
	AxisCmd_xJogYNeg := HMI_xJogYNeg AND NOT xIlk_BlockYNeg;
	AxisCmd_xJogZPos := HMI_xJogZPos AND NOT xIlk_BlockZPlus;
	AxisCmd_xJogZNeg := HMI_xJogZNeg AND NOT xIlk_BlockZNeg;
	IF xM5Ready THEN
		AxisCmd_xJogRPos := HMI_xJogRPos;
		AxisCmd_xJogRNeg := HMI_xJogRNeg;
	END_IF;
END_IF;

(* ===== 自动 ===== *)
IF Dev_xRun AND (eOpMode = 1) AND NOT HMI_xStop THEN
	IF iAutoStep = 0 AND xAutoStartEdge THEN
		iAutoStep := 1;
		rRHold := AxisFb_rPosR;
		xMoveXSent := FALSE; xMoveYSent := FALSE;
		HMI_xAutoDone := FALSE;
		HMI_xAutoBusy := TRUE;
	END_IF;

	CASE iAutoStep OF
		1: (* MoveX *)
			AxisCmd_xHoldR := TRUE;
			AxisCmd_rRHoldPos := rRHold;
			AxisCmd_rMoveDistX := HMI_rAutoDistX;
			AxisCmd_rMoveVelX := HMI_rAutoVelX;
			AxisCmd_xMoveRelX := TRUE;
			IF AxisFb_xMoveDoneX THEN
				AxisCmd_xMoveRelX := FALSE;
				iAutoStep := 2;
			END_IF;
		2: (* PressZ *)
			AxisCmd_xHoldR := TRUE;
			AxisCmd_rRHoldPos := rRHold;
			AxisCmd_xUseZVelCmd := TRUE;
			IF rForceAct &gt;= HMI_rForceSet THEN
				AxisCmd_rZVelCmd := 0.0;
				iAutoStep := 3;
				xMoveYSent := FALSE;
			ELSE
				AxisCmd_rZVelCmd := -ABS(HMI_rAutoVelZ);
			END_IF;
		3: (* MoveY + 恒力 *)
			AxisCmd_xHoldR := TRUE;
			AxisCmd_rRHoldPos := rRHold;
			AxisCmd_rMoveDistY := AxisCmd_rWheelBase;
			AxisCmd_rMoveVelY := HMI_rAutoVelY;
			AxisCmd_xMoveRelY := TRUE;
			AxisCmd_xUseZVelCmd := TRUE;
			AxisCmd_rZVelCmd := LIMIT(-ABS(HMI_rAutoVelZ),
				rForceKp * (HMI_rForceSet - rForceAct), ABS(HMI_rAutoVelZ));
			IF AxisFb_xMoveDoneY THEN
				AxisCmd_xMoveRelY := FALSE;
				AxisCmd_rZVelCmd := 0.0;
				iAutoStep := 4;
			END_IF;
		4: (* RWobble 占位 *)
			iAutoStep := 5;
		5: (* Done *)
			HMI_xAutoBusy := FALSE;
			HMI_xAutoDone := TRUE;
			iAutoStep := 0;
	END_CASE;
END_IF;

IF Dev_xError THEN
	IF xEStopLatched OR NOT HMI_xEStop THEN
		iAlarmID := 1001;
	ELSIF NOT HMI_xForceSimEnable AND Force_xTimeout THEN
		iAlarmID := 1005;
	ELSE
		iAlarmID := 1002;
	END_IF;
ELSIF iAlarmID &lt;&gt; 1004 THEN
	iAlarmID := 0;
END_IF;

HMI_iAutoStepShow := iAutoStep;
HMI_xLampEStop := xEStopLatched OR NOT HMI_xEStop;
HMI_xLampEnableOk := Dev_xRun;
HMI_xLampFault := xFaultAggregate;
HMI_iAlarmShow := iAlarmID;

StopLamp := Dev_xStop;
StartLamp := Dev_xRun;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/pathstructure" handleUnknown="discard">
            <pathStructure isFolder="False" name="Device" namespace="1ee21fdd-5562-44a0-a3ce-665d74916d50" factoryName="Inovance.InoPro.InoDeviceObject.DeviceObjectFactory" factoryGuid="{84d12aa5-3225-473b-9df6-18af40889bdf}" objectGuid="d7de5ac3-3f30-45ac-8468-ec250b4e523b">
              <pathStructure isFolder="False" name="Plc Logic" namespace="00000000-0000-0000-0000-000000000000" factoryName="_3S.CoDeSys.PlcLogicObject.PlcLogicObjectFactory" factoryGuid="{8ceeba4e-ac7a-4fbd-9415-bfb2d98668ab}" objectGuid="8a291c6e-c5c5-4a07-8c04-1100df0e1491">
                <pathStructure isFolder="False" name="Application" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="_3S.CoDeSys.ApplicationObject.ApplicationObjectFactory" factoryGuid="{ECADC42E-716E-4ff3-A93C-0CD143F9743F}" objectGuid="69822df8-b9c0-4a01-9450-b2cdc030688c">
                  <pathStructure isFolder="False" name="PRG_Logic" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="Inovance.InoPro.InoPOUObject.POUObjectFactory" factoryGuid="{39C4ED2B-903C-464c-9041-7DF4ECEE9609}" objectGuid="a1b2c3d4-e5f6-4789-a012-333333333333" />
                </pathStructure>
              </pathStructure>
            </pathStructure>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>a1b2c3d4-e5f6-4789-a012-333333333333</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="FB_Servo" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="xEnable">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xJogPos">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xJogNeg">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xStop">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xResetFault">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xHome">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xUseVelCmd">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="rVelCmd">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="rJogVel">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="rAcc">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="rDec">
              <type>
                <REAL />
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="xPowered">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xMoving">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xStandstill">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xHomed">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xFault">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="rActPos">
              <type>
                <LREAL />
              </type>
            </variable>
          </outputVars>
          <inOutVars>
            <variable name="Axis">
              <type>
                <derived name="AXIS_REF_SM3" />
              </type>
            </variable>
          </inOutVars>
          <localVars>
            <variable name="fbPower">
              <type>
                <derived name="MC_Power" />
              </type>
            </variable>
            <variable name="fbJog">
              <type>
                <derived name="MC_MoveVelocity" />
              </type>
            </variable>
            <variable name="fbStop">
              <type>
                <derived name="MC_Stop" />
              </type>
            </variable>
            <variable name="fbHome">
              <type>
                <derived name="MC_Home" />
              </type>
            </variable>
            <variable name="fbReset">
              <type>
                <derived name="MC_Reset" />
              </type>
            </variable>
            <variable name="fbReadStatus">
              <type>
                <derived name="MC_ReadStatus" />
              </type>
            </variable>
            <variable name="fbReadPos">
              <type>
                <derived name="MC_ReadActualPosition" />
              </type>
            </variable>
            <variable name="xEnInternal">
              <type>
                <BOOL />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* 读轴状态 / 实际位置 *)
fbReadStatus(Axis := Axis, Enable := TRUE);
fbReadPos(Axis := Axis, Enable := TRUE);

rActPos := fbReadPos.Position;
xStandstill := fbReadStatus.StandStill;
xMoving := fbReadStatus.DiscreteMotion OR fbReadStatus.ContinuousMotion;

(* 故障汇总：Errorstop + 各 FB.Error（不用 Axis.bError / Operational） *)
xFault := fbReadStatus.Errorstop
	OR fbReadStatus.Error
	OR fbPower.Error
	OR fbJog.Error
	OR fbStop.Error
	OR fbReset.Error;

(* 错误复位脉冲（来自停止钮长按 3s → AxisCmd_xResetFault） *)
fbReset(Axis := Axis, Execute := xResetFault);

(* 内部使能：请求使能且未停且非 Errorstop *)
xEnInternal := xEnable AND NOT xStop AND NOT fbReadStatus.Errorstop;

(* 功率级：Enable 恒 TRUE 以刷新；实际开/关看 bRegulatorOn/bDriveStart *)
fbPower(
	Axis := Axis,
	Enable := TRUE,
	bRegulatorOn := xEnInternal,
	bDriveStart := xEnInternal
);
(* Status=TRUE 表示轴可运动 *)
xPowered := fbPower.Status;

(* ---------- 运动仲裁 ---------- *)
IF xStop OR NOT xEnable OR fbReadStatus.Errorstop THEN
	(* 停止 / 禁使能 / 故障：停速度指令并减速停 *)
	fbJog(Axis := Axis, Execute := FALSE);
	fbHome(Axis := Axis, Execute := FALSE);
	fbStop(Axis := Axis, Execute := TRUE, Deceleration := rDec);

ELSIF xHome THEN
	(* 回零 *)
	fbStop(Axis := Axis, Execute := FALSE);
	fbJog(Axis := Axis, Execute := FALSE);
	fbHome(Axis := Axis, Execute := TRUE);

ELSIF xUseVelCmd THEN
	(* 成对速度模式：使用有符号 rVelCmd（来自 FB_XDiff） *)
	fbStop(Axis := Axis, Execute := FALSE);
	fbHome(Axis := Axis, Execute := FALSE);
	IF ABS(rVelCmd) &gt; 1.0E-6 AND xPowered THEN
		fbJog(Axis := Axis, Execute := TRUE, Velocity := rVelCmd, Acceleration := rAcc, Deceleration := rDec);
	ELSE
		fbJog(Axis := Axis, Execute := FALSE);
	END_IF;

ELSIF xJogPos XOR xJogNeg THEN
	(* 独立 JOG *)
	fbStop(Axis := Axis, Execute := FALSE);
	fbHome(Axis := Axis, Execute := FALSE);
	IF xPowered THEN
		IF xJogPos THEN
			fbJog(Axis := Axis, Execute := TRUE, Velocity := ABS(rJogVel), Acceleration := rAcc, Deceleration := rDec);
		ELSE
			fbJog(Axis := Axis, Execute := TRUE, Velocity := -ABS(rJogVel), Acceleration := rAcc, Deceleration := rDec);
		END_IF;
	ELSE
		fbJog(Axis := Axis, Execute := FALSE);
	END_IF;

ELSE
	(* 空闲 *)
	fbJog(Axis := Axis, Execute := FALSE);
	fbHome(Axis := Axis, Execute := FALSE);
	fbStop(Axis := Axis, Execute := FALSE);
END_IF;

IF fbHome.Done THEN
	xHomed := TRUE;
END_IF;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/pathstructure" handleUnknown="discard">
            <pathStructure isFolder="False" name="Device" namespace="1ee21fdd-5562-44a0-a3ce-665d74916d50" factoryName="Inovance.InoPro.InoDeviceObject.DeviceObjectFactory" factoryGuid="{84d12aa5-3225-473b-9df6-18af40889bdf}" objectGuid="d7de5ac3-3f30-45ac-8468-ec250b4e523b">
              <pathStructure isFolder="False" name="Plc Logic" namespace="00000000-0000-0000-0000-000000000000" factoryName="_3S.CoDeSys.PlcLogicObject.PlcLogicObjectFactory" factoryGuid="{8ceeba4e-ac7a-4fbd-9415-bfb2d98668ab}" objectGuid="8a291c6e-c5c5-4a07-8c04-1100df0e1491">
                <pathStructure isFolder="False" name="Application" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="_3S.CoDeSys.ApplicationObject.ApplicationObjectFactory" factoryGuid="{ECADC42E-716E-4ff3-A93C-0CD143F9743F}" objectGuid="69822df8-b9c0-4a01-9450-b2cdc030688c">
                  <pathStructure isFolder="True" name="FB" namespace="00000000-0000-0000-0000-000000000000" factoryName="Inovance.InoPro.InoNavigators.FolderObjectFactory" factoryGuid="{BA66A801-C738-4176-B072-DFE26ACE36D3}" objectGuid="2dc75837-520f-43d9-90dd-47cded0212a2">
                    <pathStructure isFolder="False" name="FB_Servo" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="Inovance.InoPro.InoPOUObject.POUObjectFactory" factoryGuid="{39C4ED2B-903C-464c-9041-7DF4ECEE9609}" objectGuid="095f55bd-5910-4f8e-b349-f7b40f09358c" />
                  </pathStructure>
                </pathStructure>
              </pathStructure>
            </pathStructure>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>095f55bd-5910-4f8e-b349-f7b40f09358c</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="FB_Force485" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="i_xEnable">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="i_bySlave">
              <type>
                <BYTE />
              </type>
              <initialValue>
                <simpleValue value="1" />
              </initialValue>
            </variable>
            <variable name="i_rScale">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.01" />
              </initialValue>
            </variable>
            <variable name="i_xTare">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="i_tTimeout">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#200ms" />
              </initialValue>
            </variable>
            <variable name="i_tPoll">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#20ms" />
              </initialValue>
            </variable>
            <variable name="i_abyRx">
              <type>
                <array>
                  <dimension lower="0" upper="63" />
                  <baseType>
                    <BYTE />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="i_uiRxLen">
              <type>
                <UINT />
              </type>
            </variable>
            <variable name="i_xRxNew">
              <type>
                <BOOL />
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="o_abyTx">
              <type>
                <array>
                  <dimension lower="0" upper="63" />
                  <baseType>
                    <BYTE />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="o_uiTxLen">
              <type>
                <UINT />
              </type>
            </variable>
            <variable name="o_xTxReq">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="o_rForce">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="o_iRaw">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="o_xOk">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="o_xTimeout">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="o_iState">
              <type>
                <INT />
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="iState">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="tonTO">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="tonPoll">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="xTarePrev">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xTareReq">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xWaiting">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xRxEdge">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xRxNewPrev">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="iFailCnt">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="wCrc">
              <type>
                <WORD />
              </type>
            </variable>
            <variable name="i">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="j">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="nPayload">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="diRaw">
              <type>
                <DINT />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* FB_Force485 — LE Modbus-RTU 协议层；串口经 i_abyRx/o_abyTx *)
o_xTxReq := FALSE;

IF NOT i_xEnable THEN
	iState := 0;
	xWaiting := FALSE;
	tonTO(IN := FALSE, PT := i_tTimeout);
	tonPoll(IN := FALSE, PT := i_tPoll);
	o_iState := 0;
	RETURN;
END_IF;

IF i_xTare AND NOT xTarePrev THEN
	xTareReq := TRUE;
END_IF;
xTarePrev := i_xTare;

xRxEdge := i_xRxNew AND NOT xRxNewPrev;
xRxNewPrev := i_xRxNew;

CASE iState OF
	0:
		iFailCnt := 0;
		o_xTimeout := FALSE;
		iState := 1;

	1:
		o_abyTx[0] := i_bySlave;
		o_abyTx[1] := 16#06;
		o_abyTx[2] := 16#00;
		o_abyTx[3] := 16#02;
		o_abyTx[4] := 16#00;
		o_abyTx[5] := 16#05;
		nPayload := 6;
		wCrc := 16#FFFF;
		FOR i := 0 TO (nPayload - 1) DO
			wCrc := XOR(wCrc;BYTE_TO_WORD(o_abyTx[i]));
			FOR j := 0 TO 7 DO
				IF (wCrc AND 16#0001) &lt;&gt; 0 THEN
					wCrc := SHR(wCrc, 1) XOR 16#A001;
				ELSE
					wCrc := SHR(wCrc, 1);
				END_IF;
			END_FOR;
		END_FOR;
		o_abyTx[nPayload] := WORD_TO_BYTE(wCrc AND 16#00FF);
		o_abyTx[nPayload + 1] := WORD_TO_BYTE(SHR(wCrc, 8));
		o_uiTxLen := INT_TO_UINT(nPayload + 2);
		o_xTxReq := TRUE;
		xWaiting := TRUE;
		tonTO(IN := FALSE, PT := i_tTimeout);
		tonTO(IN := TRUE, PT := i_tTimeout);
		iState := 2;

	2:
		tonTO(IN := xWaiting, PT := i_tTimeout);
		IF xRxEdge AND xWaiting THEN
			xWaiting := FALSE;
			IF (i_uiRxLen &gt;= 8) AND (i_abyRx[0] = i_bySlave) AND (i_abyRx[1] = 16#06) THEN
				iFailCnt := 0;
				o_xOk := TRUE;
				o_xTimeout := FALSE;
				IF xTareReq THEN
					iState := 5;
				ELSE
					iState := 3;
				END_IF;
			ELSE
				iFailCnt := iFailCnt + 1;
				iState := 1;
			END_IF;
		ELSIF tonTO.Q THEN
			xWaiting := FALSE;
			iFailCnt := iFailCnt + 1;
			IF iFailCnt &gt;= 3 THEN
				o_xTimeout := TRUE;
				o_xOk := FALSE;
			END_IF;
			iState := 1;
		END_IF;

	3:
		IF xTareReq THEN
			iState := 5;
		ELSE
			o_abyTx[0] := i_bySlave;
			o_abyTx[1] := 16#03;
			o_abyTx[2] := 16#00;
			o_abyTx[3] := 16#00;
			o_abyTx[4] := 16#00;
			o_abyTx[5] := 16#01;
			nPayload := 6;
			wCrc := 16#FFFF;
			FOR i := 0 TO (nPayload - 1) DO
				wCrc := XOR(wCrc, BYTE_TO_WORD(o_abyTx[i]));
				FOR j := 0 TO 7 DO
					IF (wCrc AND 16#0001) &lt;&gt; 0 THEN
						wCrc := SHR(wCrc, 1) XOR 16#A001;
					ELSE
						wCrc := SHR(wCrc, 1);
					END_IF;
				END_FOR;
			END_FOR;
			o_abyTx[nPayload] := WORD_TO_BYTE(wCrc AND 16#00FF);
			o_abyTx[nPayload + 1] := WORD_TO_BYTE(SHR(wCrc, 8));
			o_uiTxLen := INT_TO_UINT(nPayload + 2);
			o_xTxReq := TRUE;
			xWaiting := TRUE;
			tonTO(IN := FALSE, PT := i_tTimeout);
			tonTO(IN := TRUE, PT := i_tTimeout);
			tonPoll(IN := FALSE, PT := i_tPoll);
			iState := 4;
		END_IF;

	4:
		tonTO(IN := xWaiting, PT := i_tTimeout);
		IF xRxEdge AND xWaiting THEN
			xWaiting := FALSE;
			IF (i_uiRxLen &gt;= 7) AND (i_abyRx[0] = i_bySlave) AND (i_abyRx[1] = 16#03) AND (i_abyRx[2] = 16#02) THEN
				wCrc := 16#FFFF;
				FOR i := 0 TO 4 DO
					wCrc := XOR(wCrc, BYTE_TO_WORD(i_abyRx[i]));
					FOR j := 0 TO 7 DO
						IF (wCrc AND 16#0001) &lt;&gt; 0 THEN
							wCrc := SHR(wCrc, 1) XOR 16#A001;
						ELSE
							wCrc := SHR(wCrc, 1);
						END_IF;
					END_FOR;
				END_FOR;
				IF (i_abyRx[5] = WORD_TO_BYTE(wCrc AND 16#00FF)) AND (i_abyRx[6] = WORD_TO_BYTE(SHR(wCrc, 8))) THEN
					diRaw := BYTE_TO_DINT(i_abyRx[3]) * 256 + BYTE_TO_DINT(i_abyRx[4]);
					IF diRaw &gt; 32767 THEN
						diRaw := diRaw - 65536;
					END_IF;
					o_iRaw := DINT_TO_INT(diRaw);
					IF i_rScale &lt; 1.0E-12 THEN
						o_rForce := INT_TO_REAL(o_iRaw);
					ELSE
						o_rForce := INT_TO_REAL(o_iRaw) * i_rScale;
					END_IF;
					iFailCnt := 0;
					o_xOk := TRUE;
					o_xTimeout := FALSE;
				ELSE
					iFailCnt := iFailCnt + 1;
				END_IF;
			ELSE
				iFailCnt := iFailCnt + 1;
			END_IF;
			IF iFailCnt &gt;= 3 THEN
				o_xTimeout := TRUE;
				o_xOk := FALSE;
			END_IF;
			tonPoll(IN := TRUE, PT := i_tPoll);
			iState := 6;
		ELSIF tonTO.Q THEN
			xWaiting := FALSE;
			iFailCnt := iFailCnt + 1;
			IF iFailCnt &gt;= 3 THEN
				o_xTimeout := TRUE;
				o_xOk := FALSE;
			END_IF;
			iState := 3;
		END_IF;

	5:
		o_abyTx[0] := i_bySlave;
		o_abyTx[1] := 16#06;
		o_abyTx[2] := 16#00;
		o_abyTx[3] := 16#11;
		o_abyTx[4] := 16#00;
		o_abyTx[5] := 16#01;
		nPayload := 6;
		wCrc := 16#FFFF;
		FOR i := 0 TO (nPayload - 1) DO
			wCrc := XOR(wCrc, BYTE_TO_WORD(o_abyTx[i]));
			FOR j := 0 TO 7 DO
				IF (wCrc AND 16#0001) &lt;&gt; 0 THEN
					wCrc := SHR(wCrc, 1) XOR 16#A001;
				ELSE
					wCrc := SHR(wCrc, 1);
				END_IF;
			END_FOR;
		END_FOR;
		o_abyTx[nPayload] := WORD_TO_BYTE(wCrc AND 16#00FF);
		o_abyTx[nPayload + 1] := WORD_TO_BYTE(SHR(wCrc, 8));
		o_uiTxLen := INT_TO_UINT(nPayload + 2);
		o_xTxReq := TRUE;
		xWaiting := TRUE;
		xTareReq := FALSE;
		tonTO(IN := FALSE, PT := i_tTimeout);
		tonTO(IN := TRUE, PT := i_tTimeout);
		iState := 7;

	6:
		tonPoll(IN := TRUE, PT := i_tPoll);
		IF xTareReq THEN
			tonPoll(IN := FALSE, PT := i_tPoll);
			iState := 5;
		ELSIF tonPoll.Q THEN
			tonPoll(IN := FALSE, PT := i_tPoll);
			iState := 3;
		END_IF;

	7:
		tonTO(IN := xWaiting, PT := i_tTimeout);
		IF xRxEdge AND xWaiting THEN
			xWaiting := FALSE;
			iState := 3;
		ELSIF tonTO.Q THEN
			xWaiting := FALSE;
			iState := 3;
		END_IF;

ELSE
	iState := 0;
END_CASE;

o_iState := iState;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/pathstructure" handleUnknown="discard">
            <pathStructure isFolder="False" name="Device" namespace="1ee21fdd-5562-44a0-a3ce-665d74916d50" factoryName="Inovance.InoPro.InoDeviceObject.DeviceObjectFactory" factoryGuid="{84d12aa5-3225-473b-9df6-18af40889bdf}" objectGuid="d7de5ac3-3f30-45ac-8468-ec250b4e523b">
              <pathStructure isFolder="False" name="Plc Logic" namespace="00000000-0000-0000-0000-000000000000" factoryName="_3S.CoDeSys.PlcLogicObject.PlcLogicObjectFactory" factoryGuid="{8ceeba4e-ac7a-4fbd-9415-bfb2d98668ab}" objectGuid="8a291c6e-c5c5-4a07-8c04-1100df0e1491">
                <pathStructure isFolder="False" name="Application" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="_3S.CoDeSys.ApplicationObject.ApplicationObjectFactory" factoryGuid="{ECADC42E-716E-4ff3-A93C-0CD143F9743F}" objectGuid="69822df8-b9c0-4a01-9450-b2cdc030688c">
                  <pathStructure isFolder="True" name="FB" namespace="00000000-0000-0000-0000-000000000000" factoryName="Inovance.InoPro.InoNavigators.FolderObjectFactory" factoryGuid="{BA66A801-C738-4176-B072-DFE26ACE36D3}" objectGuid="2dc75837-520f-43d9-90dd-47cded0212a2">
                    <pathStructure isFolder="False" name="FB_Force485" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="Inovance.InoPro.InoPOUObject.POUObjectFactory" factoryGuid="{39C4ED2B-903C-464c-9041-7DF4ECEE9609}" objectGuid="a1b2c3d4-e5f6-4789-a012-666666666666" />
                  </pathStructure>
                </pathStructure>
              </pathStructure>
            </pathStructure>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>a1b2c3d4-e5f6-4789-a012-666666666666</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="PRG_Force485" pouType="program">
        <interface>
          <localVars>
            <variable name="fbForce">
              <type>
                <derived name="FB_Force485" />
              </type>
            </variable>
            <variable name="i">
              <type>
                <INT />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* PRG_Force485 — ForceTask 独立；串口经 Force_aby* 对接 SoftComm *)
fbForce(
	i_xEnable := Force_xEnable,
	i_bySlave := Force_bySlave,
	i_rScale := Force_rScale,
	i_xTare := HMI_xForceTare,
	i_tTimeout := T#200MS,
	i_tPoll := T#20MS,
	i_abyRx := Force_abyRx,
	i_uiRxLen := Force_uiRxLen,
	i_xRxNew := Force_xRxNew);

FOR i := 0 TO 63 DO
	Force_abyTx[i] := fbForce.o_abyTx[i];
END_FOR;
Force_uiTxLen := fbForce.o_uiTxLen;
Force_xTxReq := fbForce.o_xTxReq;

Force_xCommOk := fbForce.o_xOk;
Force_xTimeout := fbForce.o_xTimeout;
Force_iRaw := fbForce.o_iRaw;
Force_iState := fbForce.o_iState;

IF NOT HMI_xForceSimEnable THEN
	IF fbForce.o_xOk THEN
		rForceAct := fbForce.o_rForce;
	END_IF;
END_IF;

IF Force_xRxNew THEN
	Force_xRxNew := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/pathstructure" handleUnknown="discard">
            <pathStructure isFolder="False" name="Device" namespace="1ee21fdd-5562-44a0-a3ce-665d74916d50" factoryName="Inovance.InoPro.InoDeviceObject.DeviceObjectFactory" factoryGuid="{84d12aa5-3225-473b-9df6-18af40889bdf}" objectGuid="d7de5ac3-3f30-45ac-8468-ec250b4e523b">
              <pathStructure isFolder="False" name="Plc Logic" namespace="00000000-0000-0000-0000-000000000000" factoryName="_3S.CoDeSys.PlcLogicObject.PlcLogicObjectFactory" factoryGuid="{8ceeba4e-ac7a-4fbd-9415-bfb2d98668ab}" objectGuid="8a291c6e-c5c5-4a07-8c04-1100df0e1491">
                <pathStructure isFolder="False" name="Application" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="_3S.CoDeSys.ApplicationObject.ApplicationObjectFactory" factoryGuid="{ECADC42E-716E-4ff3-A93C-0CD143F9743F}" objectGuid="69822df8-b9c0-4a01-9450-b2cdc030688c">
                  <pathStructure isFolder="False" name="PRG_Force485" namespace="e5b60c93-5445-4e40-ada9-cd9c005549b4" factoryName="Inovance.InoPro.InoPOUObject.POUObjectFactory" factoryGuid="{39C4ED2B-903C-464c-9041-7DF4ECEE9609}" objectGuid="a1b2c3d4-e5f6-4789-a012-777777777777" />
                </pathStructure>
              </pathStructure>
            </pathStructure>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>a1b2c3d4-e5f6-4789-a012-777777777777</ObjectId>
          </data>
        </addData>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations />
  </instances>
  <addData>
    <data name="http://www.3s-software.com/plcopenxml/coverType" handleUnknown="implementation">
      <isCover value="True" />
    </data>
    <data name="http://www.3s-software.com/plcopenxml/globalvars" handleUnknown="implementation">
      <globalVars name="GVL">
        <variable name="StartBtn" address="%IX1.6">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【面板启动】AT %IX1.6 → HMI_xStart/HMI_xEnable（上升沿 STOP→RUN）</xhtml>
          </documentation>
        </variable>
        <variable name="StopBtn" address="%IX1.4">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【面板停止】AT %IX1.4 → HMI_xStop</xhtml>
          </documentation>
        </variable>
        <variable name="ResetBtn">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【面板复位】→ HMI_xStopHold3s（错误复位脉冲）；地址现场可另绑</xhtml>
          </documentation>
        </variable>
        <variable name="EStop" address="%IX0.4">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【面板急停】AT %IX0.4 正常=TRUE 按下=FALSE → 直通 HMI_xEStop</xhtml>
          </documentation>
        </variable>
        <variable name="StopLamp" address="%QX0.6">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【停止指示灯】AT %QX0.6 ← Dev_xStop（停止/待机）</xhtml>
          </documentation>
        </variable>
        <variable name="StartLamp" address="%QX0.7">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【启动/运行指示灯】AT %QX0.7 ← Dev_xRun（正在运行）</xhtml>
          </documentation>
        </variable>
        <variable name="JogVel">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">面板点动速度 → 桥接到 HMI_rJogVel*</xhtml>
          </documentation>
        </variable>
        <variable name="JogFwd">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">面板前进 → 按 X 模式映射到 Sync/Diff/独立点动+</xhtml>
          </documentation>
        </variable>
        <variable name="JogBwd">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">面板后退 → 按 X 模式映射到 Sync/Diff/独立点动-</xhtml>
          </documentation>
        </variable>
        <variable name="JogUp">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">面板上 → HMI_xJogZPos</xhtml>
          </documentation>
        </variable>
        <variable name="JogDown">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">面板下 → HMI_xJogZNeg</xhtml>
          </documentation>
        </variable>
        <variable name="JogRight">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">面板右 → HMI_xJogYPos</xhtml>
          </documentation>
        </variable>
        <variable name="JogLeft">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">面板左 → HMI_xJogYNeg</xhtml>
          </documentation>
        </variable>
        <variable name="JogClockAdd">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">顺时针</xhtml>
          </documentation>
        </variable>
        <variable name="JogClockMis">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">逆时针</xhtml>
          </documentation>
        </variable>
        <variable name="JogACC">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">点动加速度 → AxisCmd_rAcc</xhtml>
          </documentation>
        </variable>
        <variable name="JogDEC">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">点动减速度 → AxisCmd_rDec</xhtml>
          </documentation>
        </variable>
        <variable name="HomeReq">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">面板回零 → HMI_xHomeReqY/Z</xhtml>
          </documentation>
        </variable>
        <variable name="CaliForReq">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">重力标定</xhtml>
          </documentation>
        </variable>
        <variable name="ClearBruch">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">毛刷清洗</xhtml>
          </documentation>
        </variable>
        <variable name="yLength">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">龙门跨距/Y长度设定 4..6m → HMI_rWheelBase</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xEStop">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【急停】TRUE=未按下(正常)；FALSE=急停按下。可按可松，锁存由Logic保持</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xStop">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【设备停止】短按RUN→STOP；长按3s故障复位</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xStopHold3s">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【停止长按满3s脉冲】清急停锁存+轴错误复位+下使能</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xEnable">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【使能/启动别名】与HMI_xStart等效；上升沿STOP→RUN</xhtml>
          </documentation>
        </variable>
        <variable name="Dev_xError">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【内部故障态】</xhtml>
          </documentation>
        </variable>
        <variable name="Dev_xRun">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【内部运行态】</xhtml>
          </documentation>
        </variable>
        <variable name="Dev_xStop">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【内部停机态】</xhtml>
          </documentation>
        </variable>
        <variable name="eDevState">
          <type>
            <INT />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【设备状态】0STOP 1RUN 2ERROR</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xDevError">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【故障灯设备级】</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xDevRun">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【运行灯】</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xDevStop">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【停机灯】</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_eOpMode">
          <type>
            <INT />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【运行方式】0手动 1自动；配合Run灯</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_eDevState">
          <type>
            <INT />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【设备状态码】0=STOP 1=RUN 2=ERROR</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xStart">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【设备启动】瞬时；上升沿STOP→RUN</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xJogYPos">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y点动+】TRUE移动 FALSE暂停；受限位/Z忙</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xJogYNeg">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y点动-】TRUE移动 FALSE暂停</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xJogZPos">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z点动+】TRUE移动 FALSE暂停</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xJogZNeg">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z点动-】TRUE移动 FALSE暂停</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xJogRPos">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R点动+】预留；M5未就绪无效</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xJogRNeg">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R点动-】预留</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_rJogVelX">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.4" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【X点动速度】龙门X基速设定</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_rSpinVel">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.0" />
          </initialValue>
        </variable>
        <variable name="HMI_rJogVelR">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.2" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"> 【R轴手动速度】</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_rSpinVel">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.3" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"> 【X轴旋转速度】</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_rJogVelY">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.4" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y点动速度】</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_rJogVelZ">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.4" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z点动速度】</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_rWheelBase">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="5.0" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【龙门跨距=Y行程】单位m，合法范围4..6；自动Y走距用此值</xhtml>
          </documentation>
        </variable>
        <variable name="xEStopLatched">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【急停锁存】按下急停置位；仅长按停止复位可清</xhtml>
          </documentation>
        </variable>
        <variable name="xEnablePermit">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【使能许可】急停未触发且无锁存且无故障；≠已上使能</xhtml>
          </documentation>
        </variable>
        <variable name="xFaultAggregate">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【故障汇总】任轴Fault</xhtml>
          </documentation>
        </variable>
        <variable name="xIlk_BlockYPlus">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【联锁禁Y+】由Y+限位派生</xhtml>
          </documentation>
        </variable>
        <variable name="xIlk_BlockYNeg">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【联锁禁Y-】由Y-限位派生</xhtml>
          </documentation>
        </variable>
        <variable name="xIlk_BlockZPlus">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【联锁禁Z+】由Z+限位派生</xhtml>
          </documentation>
        </variable>
        <variable name="xIlk_BlockZNeg">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【联锁禁Z-】由Z-限位派生</xhtml>
          </documentation>
        </variable>
        <variable name="xIlk_BlockYWhenZ">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z动禁Y】Z运动中禁止Y点动</xhtml>
          </documentation>
        </variable>
        <variable name="xM5Ready">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【第5轴就绪】FALSE=忽略R轴</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xLampEStop">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【急停灯】HMI读；锁存或按钮仍按下</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xLampEnableOk">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【使能/运行灯】=设备RUN</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_xLampFault">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【轴故障灯】</xhtml>
          </documentation>
        </variable>
        <variable name="eOpMode">
          <type>
            <INT />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【运行模式】0=手动Manual（本期固定）</xhtml>
          </documentation>
        </variable>
        <variable name="iAlarmID">
          <type>
            <INT />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【内部报警号】Logic判定后拷贝到HMI_iAlarmShow</xhtml>
          </documentation>
        </variable>
        <variable name="HMI_iAlarmShow">
          <type>
            <INT />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【报警号】0无；1001急停；1002故障；1003限位；1004无许可；1099R未就绪</xhtml>
          </documentation>
        </variable>
        <variable name="I_xLimYPos">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y正限位】物理输入，地址%I* TBD</xhtml>
          </documentation>
        </variable>
        <variable name="I_xLimYNeg">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y负限位】物理输入</xhtml>
          </documentation>
        </variable>
        <variable name="I_xHomeY">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y原点】物理输入</xhtml>
          </documentation>
        </variable>
        <variable name="I_xLimZPos">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z正限位】物理输入</xhtml>
          </documentation>
        </variable>
        <variable name="I_xLimZNeg">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z负限位】物理输入</xhtml>
          </documentation>
        </variable>
        <variable name="I_xHomeZ">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z原点】物理输入</xhtml>
          </documentation>
        </variable>
        <variable name="I_xLimRPos">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R正限位】预留</xhtml>
          </documentation>
        </variable>
        <variable name="I_xLimRNeg">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R负限位】预留</xhtml>
          </documentation>
        </variable>
        <variable name="I_xHomeR">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R原点】预留</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_xPower">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【轴使能命令】仅设备RUN时TRUE</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_xJogYPos">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y点动+命令】含限位/Z忙门控</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_xJogYNeg">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y点动-命令】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_xJogZPos">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z点动+命令】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_xJogZNeg">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z点动-命令】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_xJogRPos">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R点动+命令】预留</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_xJogRNeg">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R点动-命令】预留</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_xStopAll">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【全停】急停/停止/故障时TRUE</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_xResetFault">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【错误复位脉冲】一拍TRUE→各轴MC_Reset</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_rWheelBase">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【跨距L命令】限幅4..6m</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_rJogVelX">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【X点动速度命令】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_rJogVelY">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y点动速度命令】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_rJogVelZ">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z点动速度命令】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_rJogVelR">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R点动速度命令】预留</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_rAcc">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【加速度】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisCmd_rDec">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【减速度】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_rVelCmdM1">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M1速度指令反馈】供HMI显示</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_rVelCmdM2">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M2速度指令反馈】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_rPosM1">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M1实际位置】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_rPosM2">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M2实际位置】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_rPosY">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y实际位置】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_rPosZ">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z实际位置】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_rPosR">
          <type>
            <REAL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R实际位置】预留</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xStandstill1">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M1静止】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xStandstill2">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M2静止】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xStandstillY">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y静止】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xStandstillZ">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z静止】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xStandstillR">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R静止】预留</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xMovingM1">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M1运动中】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xMovingM2">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M2运动中】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xMovingY">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y运动中】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xMovingZ">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z运动中】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xMovingR">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R运动中】预留</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xPoweredM1">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M1已使能】驱动功率级就绪，HMI灯</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xPoweredM2">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M2已使能】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xPoweredY">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y已使能】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xPoweredZ">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z已使能】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xPoweredR">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R已使能】预留</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xHomedY">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y已回零】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xHomedZ">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z已回零】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xHomedR">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R已回零】预留</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xFaultM1">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M1故障】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xFaultM2">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【M2故障】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xFaultY">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Y故障】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xFaultZ">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【Z故障】</xhtml>
          </documentation>
        </variable>
        <variable name="AxisFb_xFaultR">
          <type>
            <BOOL />
          </type>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">【R故障】预留</xhtml>
